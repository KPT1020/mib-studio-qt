# ThreadSanitizer suppressions for uninstrumented third-party libraries.
# These are not our code. Our code must remain clean; do NOT add suppressions
# for backend::* here.
#
# Note: the Qt-network LUT manifest fetch (which pulled in glib/libproxy/gio
# threading noise) is avoided in CI by pointing
# MIB_STUDIO_EMODULUS_LUT_MANIFEST_URL at a file: URL, so those library
# suppressions are intentionally NOT needed here.

# OpenCV's GDAL image plugin reports an internal lock-order-inversion while
# decoding TIFF frames (mock camera).
called_from_lib:libgdal.so
deadlock:CPLAcquireMutex

# GLib/GObject one-time init races during Qt/OpenCV startup.
called_from_lib:libglib-2.0.so
called_from_lib:libgobject-2.0.so
race:libglib-2.0.so

# Intel TBB (OpenCV's parallel_for backend on some builds, e.g. Ubuntu's
# libopencv-dev linked against libtbb). TBB's scalable allocator manages its
# own worker-thread buffers with atomics/fences TSan cannot model when the
# library is uninstrumented, so it reports self-contained delete[]-vs-read
# races entirely within libtbb (no backend:: frames). Not our code.
called_from_lib:libtbb.so
race:libtbb.so
