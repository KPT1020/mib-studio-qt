# Matches the prevailing style in src/: 4-space indent, attached braces,
# short guard clauses on one line. Format-on-touch policy: format files you
# edit; do not bulk-reformat untouched code (see docs/golden-principles.md).
BasedOnStyle: LLVM
Standard: c++17
IndentWidth: 4
ColumnLimit: 100
AccessModifierOffset: -4
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortFunctionsOnASingleLine: Inline
AllowShortLambdasOnASingleLine: All
BreakBeforeBraces: Attach
PointerAlignment: Left
SortIncludes: false
